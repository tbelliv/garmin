# Copy to .env and adjust. Never put the Garmin API key here; it lives in
# config/garmin-api-key (chmod 600, owned by PUID).

# Host user that owns /srv/fitness-data and /opt/fitness-data/state (run `id`).
PUID=1000
PGID=1000

DATA_ROOT=/srv/fitness-data
IMPORT_ROOT=/srv/fitness-imports
TZ=America/Denver

# Historical import. Days before the first day with account data are reported
# as skipped (DAY_ENDPOINT_START=auto) instead of being requested one by one.
BACKFILL_START=2015-01-01
DAY_ENDPOINT_START=auto

# Re-fetch this many recent days on every run (late-arriving data, edits).
OVERLAP_DAYS=7

# Pacing. Garmin does not publish Personal API rate limits; stay conservative.
MIN_REQUEST_INTERVAL_SECONDS=1.0
MAX_RETRIES=5
RANGE_CHUNK_DAYS=28
ACTIVITY_PAGE_SIZE=50

# Daemon: one sync cycle every N minutes, spending at most M minutes on history.
SYNC_INTERVAL_MINUTES=180
BACKFILL_BUDGET_MINUTES=120
